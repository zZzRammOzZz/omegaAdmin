# Copy to .env.local
# Same project as the mobile app (Supabase > Project Settings > API Keys)
# Server-only — do not prefix these with NEXT_PUBLIC_
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Needed to create / suspend / delete technician accounts.
# Never expose this key in the mobile app or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
