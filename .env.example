# Copy to .env.local
# Same project as the mobile app (Supabase > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Needed to create / suspend / delete technician accounts.
# Never expose this key in the mobile app or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
